                        </div>
                        <div class="col-md-6">
                            <table class="table">
                                <tbody>
                                    <tr><td class="text-muted">Max Exec Time</td><td class="fw-bold"><?= ini_get('max_execution_time') ?>s</td></tr>
                                    <tr><td class="text-muted">Upload Max Size</td><td class="fw-bold"><?= ini_get('upload_max_filesize') ?></td></tr>
                                    <tr><td class="text-muted">Post Max Size</td><td class="fw-bold"><?= ini_get('post_max_size') ?></td></tr>
                                    <tr><td class="text-muted">Memory Limit</td><td class="fw-bold"><?= ini_get('memory_limit') ?></td></tr>
