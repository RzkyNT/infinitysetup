    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const isWindows = <?= $isWindows ? 'true' : 'false' ?>;
        const sysUser = '<?= $sys_user ?>';
        const sysHost = '<?= $sys_host ?>';
        let currentCwd = '<?= addslashes($_SESSION['terminal_cwd']) ?>';
        let cmdHistory = [];
        let histIndex = -1;
        let processInterval, telemetryInterval;

        // System Monitor Circular Gauges
        function updateTelemetry() {
            fetch('?api=get_telemetry').then(r => r.json()).then(data => {
                // CPU
                document.getElementById('cpu-gauge').style.setProperty('--p', data.cpu.percentage);
                document.getElementById('cpu-gauge-val').innerText = Math.round(data.cpu.percentage) + '%';
                document.getElementById('cpu-processes').innerText = data.cpu.percentage + '% Load';
                
                // RAM
                if (data.ram.total !== 'Unknown') {
                    document.getElementById('ram-gauge').style.setProperty('--p', data.ram.percentage);
                    document.getElementById('ram-gauge-val').innerText = Math.round(data.ram.percentage) + '%';
                    document.getElementById('ram-details').innerText = `${data.ram.used} / ${data.ram.total}`;
                } else {
                    document.getElementById('ram-details').innerText = 'PHP: ' + data.php_memory.used;
                }
                
                // Disk
                document.getElementById('disk-gauge').style.setProperty('--p', data.disk.percentage);
                document.getElementById('disk-gauge-val').innerText = Math.round(data.disk.percentage) + '%';
                document.getElementById('disk-details').innerText = `${data.disk.used} / ${data.disk.total}`;
            }).catch(err => console.error("Telemetry error:", err));
        }
        updateTelemetry();
        telemetryInterval = setInterval(updateTelemetry, 4000);

        // Terminal Logic
        const consoleBody = document.getElementById('console-body');
        const consoleInput = document.getElementById('console-input');
        const promptLabel = document.getElementById('terminal-prompt');

        function updateCwdDisplays(path) {
            currentCwd = path;
            if (isWindows) {
                promptLabel.innerText = `${path.replace(/\//g, '\\')}>`;
            } else {
                let displayPath = path.replace('<?= str_replace('\\', '/', __DIR__) ?>', '~');
                promptLabel.innerText = `${sysUser}@${sysHost}:${displayPath}$`;
            }
            consoleBody.scrollTop = consoleBody.scrollHeight;
        }
        updateCwdDisplays(currentCwd);

        function clearConsole() {
            consoleBody.innerHTML = '';
            consoleInput.focus();
        }

        consoleInput.addEventListener('keydown', function(e) {
            if (e.key === 'ArrowUp') {
                e.preventDefault();
                if (histIndex < cmdHistory.length - 1) {
                    histIndex++;
                    consoleInput.value = cmdHistory[cmdHistory.length - 1 - histIndex];
                }
            } else if (e.key === 'ArrowDown') {
                e.preventDefault();
                if (histIndex > 0) {
                    histIndex--;
                    consoleInput.value = cmdHistory[cmdHistory.length - 1 - histIndex];
                } else {
                    histIndex = -1;
                    consoleInput.value = '';
                }
            } else if (e.key === 'Enter') {
                const command = this.value.trim();
                if (command === '') return;
                
                cmdHistory.push(command);
                histIndex = -1;
                this.value = '';
                
                // Print executed command
                consoleBody.innerHTML += `<span style="color:#aaa;">${promptLabel.innerText} ${command}</span>\n`;
                
                if (command === 'clear' || command === 'cls') {
                    clearConsole();
                    return;
                }
                
                const formData = new FormData();
                formData.append('command', command);
                
                fetch('?api=terminal_execute', { method: 'POST', body: formData })
                .then(res => res.json())
                .then(data => {
                    if (data.output) {
                        consoleBody.innerHTML += `<span style="color:#fff;">${data.output}</span>\n`;
                    }
                    updateCwdDisplays(data.cwd);
                })
                .catch(err => {
                    consoleBody.innerHTML += `<span style="color:#ff3b3b;">Execution failed. Connection error.</span>\n`;
                    consoleBody.scrollTop = consoleBody.scrollHeight;
                });
            }
        });

        // Process Manager Logic
        function refreshProcessList() {
            const tableBody = document.getElementById('process-table-body');
            tableBody.innerHTML = '<tr><td colspan="6" class="text-center text-muted py-4"><div class="spinner-border spinner-border-sm"></div> Scanning...</td></tr>';
            
            fetch('?api=process_list').then(r => r.json()).then(data => {
                if (!data.processes.length) {
                    tableBody.innerHTML = '<tr><td colspan="6" class="text-center text-muted py-4">No processes found.</td></tr>';
                    return;
                }
                
                let html = '';
                data.processes.forEach(p => {
                    let memClass = '';
                    let memVal = parseFloat(p.mem);
                    if (memVal > 500) memClass = 'mem-high';
                    else if (memVal > 100) memClass = 'mem-med';
                    
                    html += `<tr>
                        <td><i class="fas fa-cog text-muted"></i> <strong>${p.name}</strong></td>
                        <td class="font-monospace text-info">${p.pid}</td>
                        <td>${p.user || '-'}</td>
                        <td class="${memClass} font-monospace">${p.mem}</td>
                        <td class="small text-muted">${p.session || '-'}</td>
                        <td class="text-center"><button class="btn btn-sm btn-outline-danger py-0 px-2" onclick="killProcess(${p.pid}, '${p.name}')"><i class="fas fa-times"></i></button></td>
                    </tr>`;
                });
                tableBody.innerHTML = html;
            }).catch(() => {
                tableBody.innerHTML = '<tr><td colspan="6" class="text-center text-danger py-4">Failed to fetch processes.</td></tr>';
            });
        }
        
        function killProcess(pid, name) {
            if (confirm(`Kill ${name} (PID: ${pid})?`)) {
                const formData = new FormData();
                formData.append('pid', pid);
                fetch('?api=process_kill', { method: 'POST', body: formData })
                .then(r => r.json()).then(() => refreshProcessList());
            }
        }

        // Auto-refresh processes when tab is active
        document.querySelector('[data-bs-target="#process-pane"]').addEventListener('shown.bs.tab', () => {
            refreshProcessList();
            processInterval = setInterval(refreshProcessList, 5000);
        });
        document.querySelector('[data-bs-target="#process-pane"]').addEventListener('hidden.bs.tab', () => {
            clearInterval(processInterval);
        });

        // Network Tools
        document.getElementById('net-tool').addEventListener('change', function() {
            document.getElementById('port-group').classList.toggle('d-none', this.value !== 'port_check');
        });
        
        document.getElementById('network-form').addEventListener('submit', function(e) {
            e.preventDefault();
            const btn = document.getElementById('net-submit-btn');
            const out = document.getElementById('network-output');
            btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';
            out.innerHTML = `<span style="color:#aaa;">Executing ${document.getElementById('net-tool').value} on ${document.getElementById('net-target').value}...</span>`;
            
            const fd = new FormData(this);
            fetch('?api=network_tool', { method: 'POST', body: fd })
            .then(r => r.json()).then(data => {
                out.textContent = data.output || 'Done.';
                btn.disabled = false; btn.innerText = 'Execute';
            }).catch(() => {
                out.innerHTML = '<span style="color:#ff3b3b;">Request Failed</span>';
                btn.disabled = false; btn.innerText = 'Execute';
            });
        });

        // Netstat
        function refreshNetstat() {
            const tb = document.getElementById('netstat-table-body');
            tb.innerHTML = '<tr><td colspan="4" class="text-center text-muted py-4">Scanning...</td></tr>';
            fetch('?api=netstat_list').then(r => r.json()).then(data => {
                document.getElementById('netstat-raw-output').textContent = data.raw;
                if (!data.connections.length) { tb.innerHTML = '<tr><td colspan="4" class="text-center py-4">No active connections</td></tr>'; return; }
                let html = '';
                data.connections.forEach(c => {
                    let stateColor = c.state.includes('LISTEN') ? 'text-info' : (c.state.includes('ESTABLISHED') ? 'text-success' : 'text-muted');
                    html += `<tr><td>${c.proto}</td><td class="font-monospace">${c.local}</td><td class="font-monospace">${c.foreign}</td><td class="${stateColor} fw-bold">${c.state}</td></tr>`;
                });
                tb.innerHTML = html;
            });
        }
        document.querySelector('[data-bs-target="#netstat-pane"]').addEventListener('shown.bs.tab', refreshNetstat);

        function toggleRawNetstat() {
            document.getElementById('netstat-parsed-view').classList.toggle('d-none');
            document.getElementById('netstat-raw-view').classList.toggle('d-none');
        }

        // Logs
        function loadLogs() {
            const type = document.getElementById('log-select-type').value;
            const box = document.getElementById('logs-output-box');
            box.innerHTML = '<div class="spinner-border spinner-border-sm"></div> Reading...';
            fetch(`?api=read_logs&log_type=${type}`).then(r => r.json()).then(data => {
                box.textContent = data.output || 'Log is empty.';
                box.scrollTop = box.scrollHeight;
            });
        }
        document.querySelector('[data-bs-target="#logs-pane"]').addEventListener('shown.bs.tab', loadLogs);
    </script>
</body>
</html>
