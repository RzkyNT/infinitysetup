    if ($_GET['api'] === 'get_telemetry') {
        $totalDisk = disk_total_space(__DIR__);
        $freeDisk = disk_free_space(__DIR__);
        $usedDisk = $totalDisk - $freeDisk;
        $diskPercentage = $totalDisk > 0 ? round(($usedDisk / $totalDisk) * 100, 1) : 0;
        $memLimit = ini_get('memory_limit');
        $memUsed = memory_get_usage(true);
        $ramTotal = 'Unknown'; $ramUsed = 'Unknown'; $ramFree = 'Unknown'; $ramPercentage = 0;
        $cpuUsage = 0;
        
        if ($isWindows) {
            $wmiRam = shell_exec('wmic OS get FreePhysicalMemory,TotalVisibleMemorySize /Value');
            if ($wmiRam) {
                preg_match('/FreePhysicalMemory=(\d+)/', $wmiRam, $freeMatches);
                preg_match('/TotalVisibleMemorySize=(\d+)/', $wmiRam, $totalMatches);
                if (isset($freeMatches[1]) && isset($totalMatches[1])) {
                    $totalKb = (float)$totalMatches[1]; $freeKb = (float)$freeMatches[1]; $usedKb = $totalKb - $freeKb;
                    $ramTotal = round($totalKb / (1024 * 1024), 2) . ' GB';
                    $ramUsed = round($usedKb / (1024 * 1024), 2) . ' GB';
                    $ramPercentage = round(($usedKb / $totalKb) * 100, 1);
                }
            }
            $wmiCpu = shell_exec('wmic cpu get LoadPercentage /Value');
            if ($wmiCpu && preg_match('/LoadPercentage=(\d+)/', $wmiCpu, $matches)) {
                $cpuUsage = (int)$matches[1];
            }
        } else {
            if (file_exists('/proc/meminfo')) {
                $meminfo = file_get_contents('/proc/meminfo');
                preg_match('/MemTotal:\s+(\d+)/', $meminfo, $totalMatches);
                preg_match('/MemAvailable:\s+(\d+)/', $meminfo, $availMatches);
                if (isset($totalMatches[1]) && isset($availMatches[1])) {
                    $totalKb = (float)$totalMatches[1]; $availKb = (float)$availMatches[1]; $usedKb = $totalKb - $availKb;
                    $ramTotal = round($totalKb / (1024 * 1024), 2) . ' GB';
                    $ramUsed = round($usedKb / (1024 * 1024), 2) . ' GB';
                    $ramPercentage = round(($usedKb / $totalKb) * 100, 1);
                }
            }
            if (file_exists('/proc/stat')) {
                $stat1 = file_get_contents('/proc/stat'); usleep(100000);
                $stat2 = file_get_contents('/proc/stat');
                $info1 = explode("\n", $stat1)[0]; $info2 = explode("\n", $stat2)[0];
                $cpu1 = array_slice(array_filter(explode(" ", $info1)), 1);
                $cpu2 = array_slice(array_filter(explode(" ", $info2)), 1);
                $total1 = array_sum($cpu1); $total2 = array_sum($cpu2);
                $idle1 = $cpu1[3] + ($cpu1[4] ?? 0); $idle2 = $cpu2[3] + ($cpu2[4] ?? 0);
                $diffTotal = $total2 - $total1; $diffIdle = $idle2 - $idle1;
                if ($diffTotal > 0) $cpuUsage = round((($diffTotal - $diffIdle) / $diffTotal) * 100, 1);
            }
        }
        
        echo json_encode([
            'disk' => ['total' => round($totalDisk / (1024*1024*1024), 2) . ' GB', 'used' => round($usedDisk / (1024*1024*1024), 2) . ' GB', 'percentage' => $diskPercentage],
            'ram' => ['total' => $ramTotal, 'used' => $ramUsed, 'percentage' => $ramPercentage],
            'cpu' => ['percentage' => $cpuUsage],
            'php_memory' => ['used' => round($memUsed / (1024 * 1024), 2) . ' MB', 'limit' => $memLimit]
        ]);
        exit;
    }
    
    if ($_GET['api'] === 'process_list') {
        $processes = [];
        if ($isWindows) {
            $cmd = 'tasklist /FO CSV /NH';
            $raw = execute_command($cmd, __DIR__);
            $lines = explode("\n", trim($raw));
            foreach ($lines as $line) {
                $data = str_getcsv(trim($line), ',', '"', "\\");
                if (count($data) >= 5) {
                    $memVal = trim(str_replace(['K', ','], '', $data[4]));
                    $processes[] = ['name' => $data[0], 'pid' => $data[1], 'session' => $data[2], 'mem' => round($memVal / 1024, 2) . ' MB', 'user' => 'N/A'];
                }
            }
        } else {
            $cmd = 'ps aux';
            $raw = execute_command($cmd, __DIR__);
            $lines = explode("\n", trim($raw));
            for ($i = 1; $i < count($lines); $i++) {
                $line = trim($lines[$i]);
                if (empty($line)) continue;
                $parts = preg_split('/\s+/', $line, 11);
                if (count($parts) >= 11) {
                    $processes[] = ['name' => basename($parts[10]), 'pid' => $parts[1], 'user' => $parts[0], 'mem' => round($parts[5] / 1024, 2) . ' MB', 'session' => 'CPU: ' . $parts[2] . '% | MEM: ' . $parts[3] . '%'];
                }
            }
        }
        // Sort by memory usage descending
        usort($processes, function($a, $b) {
            return (float)$b['mem'] <=> (float)$a['mem'];
        });
        echo json_encode(['processes' => $processes]);
        exit;
    }
    
    if ($_GET['api'] === 'process_kill') {
        $pid = (int)($_POST['pid'] ?? 0);
        if ($pid <= 0) { echo json_encode(['success' => false, 'message' => 'Invalid Process ID']); exit; }
        $cmd = $isWindows ? "taskkill /F /PID $pid" : "kill -9 $pid";
        $output = execute_command($cmd, __DIR__);
        echo json_encode(['success' => true, 'output' => trim($output)]);
        exit;
    }
    
    if ($_GET['api'] === 'network_tool') {
        $tool = $_POST['tool'] ?? '';
        $target = escapeshellarg($_POST['target'] ?? '');
        $output = '';
        if (empty($tool) || empty($target)) { echo json_encode(['output' => 'Invalid parameters.']); exit; }
        
        switch ($tool) {
            case 'ping':
                $countFlag = $isWindows ? '-n 4' : '-c 4';
                $output = execute_command("ping $countFlag $target", __DIR__);
                break;
            case 'nslookup':
                $output = execute_command("nslookup $target", __DIR__);
                break;
            case 'port_check':
                $port = (int)($_POST['port'] ?? 80);
                $cleanTarget = $_POST['target'] ?? '';
                $start = microtime(true);
                $fp = @fsockopen($cleanTarget, $port, $errno, $errstr, 4);
                $duration = round((microtime(true) - $start) * 1000, 2);
                $output = $fp ? "Port $port is OPEN on $cleanTarget (Latency: {$duration}ms)" : "Port $port is CLOSED on $cleanTarget\nError: [$errno] $errstr";
                if ($fp) fclose($fp);
                break;
        }
        echo json_encode(['output' => trim($output)]);
        exit;
    }
    
    if ($_GET['api'] === 'netstat_list') {
        $connections = [];
        $raw = execute_command('netstat -an', __DIR__);
        $lines = explode("\n", trim($raw));
        foreach ($lines as $line) {
            $line = trim($line);
            if (empty($line)) continue;
            $parts = preg_split('/\s+/', $line);
            if (count($parts) >= 4) {
                $proto = strtoupper($parts[0]);
                if (in_array($proto, ['TCP', 'UDP'])) {
                    $connections[] = ['proto' => $proto, 'local' => $parts[1], 'foreign' => $parts[2], 'state' => $parts[3] ?? 'LISTEN'];
                }
            }
        }
        echo json_encode(['connections' => $connections, 'raw' => $raw]);
        exit;
    }
    
    if ($_GET['api'] === 'read_logs') {
        $logType = $_GET['log_type'] ?? '';
        $output = '';
        if ($logType === 'api') $logFile = __DIR__ . '/api_logs.json';
