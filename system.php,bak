                                    <tr><td class="text-muted">PHP Version</td><td class="fw-bold"><?= htmlspecialchars($php_version) ?></td></tr>
                                    <tr><td class="text-muted">Server Software</td><td class="fw-bold"><?= htmlspecialchars($server_software) ?></td></tr>
                                </tbody>
