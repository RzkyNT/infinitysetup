                $data = json_decode(file_get_contents($logFile), true);
                $output = is_array($data) ? json_encode($data, JSON_PRETTY_PRINT) : file_get_contents($logFile);
            } else {
                $file = escapeshellarg($logFile);
                $output = $isWindows ? execute_command("powershell -Command \"Get-Content $file -Tail 100\"", __DIR__) : execute_command("tail -n 100 $file", __DIR__);
            }
        } else {
            $output = "Log file is empty or not readable.";
        }
        echo json_encode(['output' => $output]);
        exit;
    }
